    {
      "id": "claim_da890f8baa464e5a90949865ec2176d0",
      "statement": "Quantity and Dim_QuantityMultiplier are mutually exclusive dimensions for counting recipe parts: Quantity is count-based (integers), while Dim_QuantityMultiplier is length-based (multipliers). A row carries either one or the other, never both. Dimensioned items (TAPE, PROFILE, DIFF, MOUNT, FLEX) default to multiplier=1; caps default to quantity=2.",
      "evidence": [
        {
          "resource": "repo://src/store/useStore.js#L40-L51",
          "version": "repo-lines-v1:sha256:760c348b79469a35d790ae2ba1905785642ca7f3c8e106a3393d44c367ddd9e8:"
        }
      ]
    },
    {
      "id": "claim_13f84eda6a38419da1351b69926013bf",
      "statement": "Context is the scope or container where a recipe row lives. ContextType is either 'PositionType' (position-level, site-first-fix) or 'ElementType' (inside a wrapper). ContextRef is the position type ref or wrapper ET ref that the row belongs to.",
