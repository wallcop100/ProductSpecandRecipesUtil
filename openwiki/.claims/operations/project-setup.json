    {
      "id": "claim_973b3ccaf49b4a1388aa8aaf032a5696",
      "statement": "File System Access API directory handles are persisted in IndexedDB with a generated key. When a folder is picked, findHandleKey checks if the folder is already recognized via isSameEntry and reuses the same key. This prevents forking empty copies when a folder is re-picked.",
      "evidence": [
        {
          "resource": "repo://src/platform/fs.js#L26-L69",
          "version": "repo-lines-v1:sha256:ffb9b771521abaf0e257a380fe473a4f24daa56a340fe7845d01da9901d18571:"
        }
      ]
    },
    {
      "id": "claim_197200d2e9f040f8834557af8d171bc1",
      "statement": "The project folder is read-only. The app never modifies DesignDB, Product Spec, or Recipes Spec files—updates leave as Office Scripts patches the user runs in Excel. This invariant is enforced by the browser: the directory handle is granted in mode: 'read' and nothing ever calls requestPermission for 'readwrite'.",
      "evidence": [
        {
          "resource": "repo://src/platform/fs.js#L1-L22",
          "version": "repo-lines-v1:sha256:ddfc6ea93dffbe05e4dbf779226fabb89ff99821cf91cc9c7279e35136fb6ee4:"
        }
      ]
    },
    {
      "id": "claim_342fd8c140a54505ae8b427317c35911",
      "statement": "detectFiles(folderKey) classifies every .xlsx file in the folder by name heuristics, returning { db, dbs, ps, rs, all_xlsx }. Detection is best-effort and silent: name heuristics look for keywords in sheet names or filenames. Only DesignDB is required; Product Spec and Recipes Spec are optional.",
      "evidence": [
        {
