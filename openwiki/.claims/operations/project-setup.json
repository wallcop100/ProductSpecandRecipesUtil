  "claims": [
    {
      "id": "claim_bc814cec341c4f38aa104a66f10d3f1a",
      "statement": "FolderSetupScreen is the landing page and only entry point into the app; it is the project list and project manager. It orchestrates folder picking, file detection, project identity confirmation, configuration management, and store initialization.",
      "evidence": [
        {
          "resource": "repo://src/screens/FolderSetupScreen.jsx#L22-L32",
          "version": "repo-lines-v1:sha256:1ec7194205b8b1345a6550f3f7689e63745d0dc88992693cdc0c27b98e6b4674:"
        }
      ]
    },
    {
      "id": "claim_5d32dc926bf942ea8b72ac7a26cf16ea",
      "statement": "Projects are uniquely identified by the pair (folder_path, config_name). folder_path is an opaque directory-handle ID generated by the File System Access API; config_name is a user-friendly overlay name. Multiple configurations can exist for the same folder, each with independent tags, templates, and unexported changes, but all read the same Excel files.",
      "evidence": [
        {
          "resource": "repo://src/platform/dbSchema.js#L137-L149",
          "version": "repo-lines-v1:sha256:7898f6b1bab1b2424e8b26185ff4e5128f0f77cc1cbfb70d8696b9a4a60210d6:"
