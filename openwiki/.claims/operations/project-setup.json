        }
      ]
    },
    {
      "id": "claim_046947994abf472f9f0d992d610fe5b0",
      "statement": "The project_number is extracted from the DesignDB filename or entered manually and is used to group and re-recognize projects and to sync configuration with a companion server. The project_label is the human-readable display name, persisted so renaming the folder does not silently rename the project.",
      "evidence": [
        {
          "resource": "repo://src/platform/dbSchema.js#L298-L305",
          "version": "repo-lines-v1:sha256:10a5ec3f2ab4d922787c26e0d88d039980ab7f081f4b08164fa8b024cb2314ce:"
