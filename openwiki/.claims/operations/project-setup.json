    },
    {
      "id": "claim_bb9941536e5c4139872a543727916ae9",
      "statement": "All overlay data—position tags, templates, collections, and unexported changes—hangs off project_id (the database row id), not folder_path. When duplicate project rows are collapsed, the project_id stays the same so work is not lost and becomes another configuration of the canonical project.",
      "evidence": [
        {
