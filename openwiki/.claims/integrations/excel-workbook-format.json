        }
      ]
    },
    {
      "id": "claim_715cb69119c14a2483a643501806b3e0",
      "statement": "The Positions sheet (optional) is used to detect 'zero placed' PositionTypes—ones the DesignDB defines but no fixture has placed yet. Deleted positions are filtered. If the sheet is missing, this detection never fires (best-effort signal).",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L264-L272",
          "version": "repo-lines-v1:sha256:9277a62cbd17f711806340eed5f3c64a11e09d1be66fe65d41c2e2fc71f10532:"
        }
      ]
    },
    {
      "id": "claim_0f9c5686d6194523975518207a791253",
      "statement": "Fully-blank rows (all cells empty within used range) are skipped during parsing. Rows with at least one non-empty cell are included. This is checked after normalizing strings and before building the output array.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L180-L205",
