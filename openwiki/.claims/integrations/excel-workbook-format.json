  "claims": [
    {
      "id": "claim_dbd518384b354bf5b9a7c23a498b5e65",
      "statement": "The xlsx.js module uses SheetJS to parse all three workbooks (DesignDB, ProductSpec, RecipesSpec) entirely in the browser. It reads workbooks from ArrayBuffer or Uint8Array bytes, supports selective sheet loading to avoid memory bloat on large junk tabs, and normalizes all row data into JavaScript objects anchored at Excel cell A1.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L1-L20",
          "version": "repo-lines-v1:sha256:79c469f964c74267c7a3b6c840f3858bc74bbc82dda9c3786029ca7c93e3bae4:"
        },
        {
          "resource": "repo://src/platform/xlsx.js#L103-L106",
          "version": "repo-lines-v1:sha256:87d94f5959142946cabbeee0bd4fc9ae1fff6d16c4cf9160f9ac5fd33e87849e:"
        }
      ]
    },
    {
      "id": "claim_e7abde533446465d9f9aedc239849546",
      "statement": "Every data row carries a _row_num field (1-based Excel absolute row number, with header = row 1) so patch scripts can target the exact row without relying on key lookups. ElementTypes retain _row_num for patching; PositionTypes strip it as they are read-only.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L176-L180",
          "version": "repo-lines-v1:sha256:5b7d6e76b8366802b8631ce3ba7ad7eac737731d4e36f68b104a60eac1170fce:"
        },
        {
          "resource": "repo://src/platform/xlsx.js#L255-L261",
          "version": "repo-lines-v1:sha256:a584e30ad773053b5487949498e1e0fa088a83d2ed85ef6386278e5bb36e8f51:"
        },
        {
          "resource": "repo://src/platform/xlsx.js#L9-L10",
          "version": "repo-lines-v1:sha256:96e7c27a978433003bc2cc24e94a20a16e512521ea15eacfdb56d384fced89f1:"
        }
      ]
    },
    {
      "id": "claim_aeadec6bd2c1405a804e238e69cf2309",
      "statement": "Identifier and code fields (ProductCode, ElementTypeRef, Ref, etc.) can be stored as Excel numbers. The parser coerces them to strings before returning, because downstream consumers call .trim() and .toLowerCase()—a single numeric cell crashes the load.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L188-L190",
          "version": "repo-lines-v1:sha256:62d69185fe7c19b2f973856332c37ebf3769d2d583b7911a360e4bad3d3098cc:"
        },
        {
          "resource": "repo://src/platform/xlsx.js#L79-L86",
          "version": "repo-lines-v1:sha256:b3830a50ed166e5e34f5b755058d895b9378e75a9827d5708fd7e55bb19ed099:"
        }
      ]
    },
    {
      "id": "claim_b9933979b33c4eca8dc28b53c6e1669a",
      "statement": "Flag columns (IsTBC, IsDeleted, IsDesign, IsContractItem, IsTRItem, IsInteger, IsPropertiesTBC) are normalized to 'Y' (present) or null (absent). String values are checked case-insensitively; empty strings and blanks become null.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L186-L188",
          "version": "repo-lines-v1:sha256:a6636f40d96836d6c0356ede50cfa94322ad0b4de8ffbe1c94b63dd7e6637b40:"
        },
        {
          "resource": "repo://src/platform/xlsx.js#L88-L91",
          "version": "repo-lines-v1:sha256:17fc7dcfed0e755de1d928d47e2348a1d8ba6ea62973136cb163f3baa92804f0:"
        }
      ]
    },
    {
      "id": "claim_a5966756120c4a8fba3cbd22446adda0",
      "statement": "Collections (rows whose Ref appears as another row's ParentRef) are filtered from returned element_types and position_types arrays. Their refs are collected separately in collection_refs so the UI knows they exist and can validate references to them, preventing false 'ET-CABLE not found' errors when the master sheet actually defines it as a parent.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L209-L221",
          "version": "repo-lines-v1:sha256:29bd1ffb6798a5a0a0c233532b97bb55f7cbff3dd4d848c2dfed467edd80d95b:"
        },
        {
          "resource": "repo://src/platform/xlsx.js#L240-L249",
          "version": "repo-lines-v1:sha256:68f249017abdd23a9b40f3bf70b06e36a90eaca8f42de679d232eec0e748348f:"
        }
      ]
    },
    {
      "id": "claim_8f357f9fa21241a2992d8b8230860994",
      "statement": "PositionTypes parsing includes all headers in the output under their own names (pass-through columns), not just the standard column map. This is necessary because tag rules may read arbitrary DB schema fields for decision-making (e.g., checking DriverLocation='Top').",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L167-L174",
          "version": "repo-lines-v1:sha256:20b8d20436df6926f701f7e0668c8483f928c5b0f113656affe8edcbdf2a61fe:"
        },
        {
          "resource": "repo://src/platform/xlsx.js#L251-L251",
          "version": "repo-lines-v1:sha256:c633538e4a997e1f05c7bf3a765d84e230eae4a784a204b6860544fedfd26db9:"
        }
      ]
    },
    {
      "id": "claim_b7ae9c32483f49689117a4ac457083fe",
      "statement": "Recipes Spec parsing expands ElementType-level rows by PositionType. It identifies which PositionTypes claim each ET as an IsDesign='Y' element, then duplicates the ET row once per claimant PositionType. Orphan ET rows (no position claims them) are dropped. This allows a single template row at ET level to expand into recipes for multiple positions using it.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L293-L320",
          "version": "repo-lines-v1:sha256:808a04736364e6e250e35e993505c0a92eabd0b54d32ca900db506bd9d651b41:"
        }
      ]
    },
    {
      "id": "claim_889fbfce302e49689e64932eb7bce34c",
      "statement": "mergeDbs() unions ElementTypes and PositionTypes by ref (case-insensitive), with the first DB listed winning on conflict. Conflicts in Name across DBs are reported. Positions are concatenated—a PositionType is live (placed) if it appears in any merged DB. This supports projects split across multiple DesignDB files (e.g., one per building) sharing a single PS and RS.",
      "evidence": [
        {
          "resource": "repo://src/platform/xlsx.js#L398-L450",
          "version": "repo-lines-v1:sha256:5ac466228cdfcd641e93eccafee9ace86d2aaa35abcb2f64d11f83518b4d0958:"
        }
      ]
    },
    {
      "id": "claim_7cafe005fbab454cb4658656104d6379",
      "statement": "All generated Office Scripts (patchScript.js) are idempotent. Before appending a new row, the script checks whether it already exists by key in the workbook. If it does, it updates in place instead of appending. This prevents the bug where pasting a patch twice would duplicate every new row—the natural key always decides append vs. update.",
      "evidence": [
        {
          "resource": "repo://src/utils/patchScript.js#L120-L128",
          "version": "repo-lines-v1:sha256:dba87f090d7727e7b628cf8acf8663307a5e6bb52714182e70618dc8b0842083:"
        },
        {
          "resource": "repo://src/utils/patchScript.js#L14-L23",
          "version": "repo-lines-v1:sha256:ac7987e5005d04ccb12b547db371b4346383fa16e3229475a25d0bac5b0eaa59:"
        },
        {
          "resource": "repo://src/utils/patchScript.js#L309-L326",
          "version": "repo-lines-v1:sha256:2f35dde18bf4fb3ad9645518f99f852ff664d7c3ab7da249f558480844e02624:"
        }
      ]
    },
    {
      "id": "claim_44d7b36394554b1cbb21e5332e45145a",
      "statement": "Patch scripts never read the whole sheet. They read only the header row and one key column (each bounded to the real row count), then do all lookups in memory. This is a learned design decision—reading getUsedRange().getValues() on templates padded with formatting to ~1,048,576 rows hangs Excel.",
      "evidence": [
        {
          "resource": "repo://src/utils/patchScript.js#L101-L109",
          "version": "repo-lines-v1:sha256:5e8bc0245f910096097f8d38f8f932a952f9a4794fc9f2f2f951364ba6dc6ecb:"
        },
        {
          "resource": "repo://src/utils/patchScript.js#L120-L128",
          "version": "repo-lines-v1:sha256:dba87f090d7727e7b628cf8acf8663307a5e6bb52714182e70618dc8b0842083:"
        },
        {
          "resource": "repo://src/utils/patchScript.js#L129-L140",
          "version": "repo-lines-v1:sha256:b5b3b16ad6cfca7be0ab920b5e91839b82aa35146bd1e69e4ac1156ae5d9adaf:"
        }
      ]
    },
    {
      "id": "claim_cb756375fab5424fa1fc5b042e43cabb",
      "statement": "After patching the DesignDB ElementTypes sheet, the script re-sorts by family hierarchy: each family first, then its members (sub-families nested inside), both by Ref in natural order (LC2 before LC11). SortOrder is written 1..N, family rows are colored purple with white bold text, and leaf rows are plain. The sort reorders whole rows (formulas and all), not just filtered columns.",
      "evidence": [
        {
          "resource": "repo://src/utils/patchScript.js#L220-L284",
          "version": "repo-lines-v1:sha256:a5fe350541c8f1b60e2c0068a7c9c976cfaddb863ca215a963ccb3d07d02cd87:"
        }
      ]
    },
    {
      "id": "claim_c389a771c524431daf9dd2548bb8ef4e",
      "statement": "Product Spec rows are keyed by EntityRef (ElementTypeRef in internal naming). This is the natural key—the patch lookup, append-vs-update decision, and staleness detection all use it. A new PS row begins with _row_num=null; the backend assigns a row number on first export.",
      "evidence": [
        {
          "resource": "repo://src/utils/patchScript.js#L25-L35",
          "version": "repo-lines-v1:sha256:ace32595d910891ec8e96040ca554d57297ac31d88c5d1c2d711c898eb6c78ca:"
        },
        {
          "resource": "repo://src/utils/patchScript.js#L286-L304",
          "version": "repo-lines-v1:sha256:ff0a885704fb8646535418c29e3eb0237224e3bfb350c96f6c37ff283198b542:"
        }
      ]
    },
    {
      "id": "claim_07cae06ca61d4b24a0fe5cf636a0aec6",
      "statement": "Recipes Spec rows are keyed by a composite: (ContextType, ContextRef, RecipeIndex, ElementTypeRef). This composite uniquely identifies a recipe entry and allows multiple items in the same position with reordering by renumbering RecipeIndex.",
      "evidence": [
        {
          "resource": "repo://src/utils/patchScript.js#L129-L140",
          "version": "repo-lines-v1:sha256:b5b3b16ad6cfca7be0ab920b5e91839b82aa35146bd1e69e4ac1156ae5d9adaf:"
        },
        {
          "resource": "repo://src/utils/patchScript.js#L75-L75",
          "version": "repo-lines-v1:sha256:d2b30dd2a86d5b58ca93a665b238542ef8fa7cccbdf885c6db8a36d1b20e5204:"
        }
      ]
    },
    {
      "id": "claim_326153310ec64280bc269279908b24d8",
      "statement": "The DesignDB ElementTypes patch uses field-to-Excel mappings: Ref (key), Name, Description, Details (free-form product identity), ParentRef (Family), IsCollection, IsDeleted, SortOrder. The script maps these at runtime by reading row 1, making column reordering transparent.",
      "evidence": [
        {
          "resource": "repo://src/utils/patchScript.js#L53-L64",
          "version": "repo-lines-v1:sha256:288ddf2d40621e5969e38f1a6c79fbd278c3eb96345608b408cf504248939a54:"
        }
      ]
    },
    {
      "id": "claim_e9e111ff73ad4fa1992f709a0030ff00",
      "statement": "backend.js exports the three former Flask routes (/detect-files, /import, /read-sheet) which now run entirely in the browser. There is no server. File handling is done against the File System Access directory handle opened by the user, and SheetJS is imported dynamically to keep it out of the initial page load.",
      "evidence": [
        {
          "resource": "repo://src/utils/backend.js#L1-L13",
          "version": "repo-lines-v1:sha256:1ed09f12f20dd0974e8184a38f1f4a0308d146daba49a322104c4e32eea53a9e:"
