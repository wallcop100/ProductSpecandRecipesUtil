  "claims": [
    {
      "id": "claim_2855f75546cc4633a8a0c4bedb35a319",
      "statement": "The app probes for a companion server at startup by requesting GET /api/capabilities, expecting a JSON response with { protocol: 'psr-companion/1', features: [...] }. If the response is missing, non-JSON, has a different protocol, or any network error occurs, the app treats it as having no companion and continues without optional features.",
      "evidence": [
        {
          "resource": "repo://src/platform/companion.js#L101-L112",
          "version": "repo-lines-v1:sha256:4f728119079d875bf187577f4f28e691685752eb448d5538d1675cd6866910e7:"
        },
        {
          "resource": "repo://tests/frontend/companion.test.js#L8-L26",
          "version": "repo-lines-v1:sha256:f9f5efc20addae570eb4f4c3e9a52c08bb622a1a4aec75ebd8d38fe75d37b48a:"
        }
      ]
    },
    {
      "id": "claim_33753c41786848e29c84650c58ce10fb",
      "statement": "Each companion feature (sweep, library, projects, contributions, etc.) is optional and determined by the features array in the /api/capabilities response. Features not listed return null, and callers treat null as 'feature unavailable, use defaults'. Only features explicitly advertised are invoked.",
      "evidence": [
        {
          "resource": "repo://src/platform/companion.js#L46-L99",
          "version": "repo-lines-v1:sha256:ba5b15321bfbbca41326bacdf49f8d98d0983c8a259fd4f8bcab45587cedad6d:"
