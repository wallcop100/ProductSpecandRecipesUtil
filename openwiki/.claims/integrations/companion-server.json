          "version": "repo-lines-v1:sha256:7021835ff3790014b1260c51af6b313a258e9a5f055e73c4b47a6fd306a97308:"
        }
      ]
    },
    {
      "id": "claim_d9a30d79fdd949ae9a4d327ee3c87ceb",
      "statement": "All companion API calls use a quiet/fallback pattern: if any endpoint fails (non-OK status, non-JSON, network error, timeout), the call returns null. The app continues without that suggestion or capability. No single failed endpoint breaks the app or stops other features from working.",
