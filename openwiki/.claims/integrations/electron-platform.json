        }
      ]
    },
    {
      "id": "claim_7fda7cf652e345d78ff6f88657ceaa16",
      "statement": "The project folder is guaranteed read-only: directory handles are opened with mode:'read', requestPermission('readwrite') is never called, and no writable stream is ever opened; files exported from the app (config YAML, library) are written to user-selected locations outside the project folder via saveAs().",
      "evidence": [
        {
          "resource": "repo://src/platform/api.js#L217-L222",
          "version": "repo-lines-v1:sha256:436d5a19e34bfbb9c17f76910fe9a7ee3afa0fc2a3a1fdd94049799b49803ee4:"
