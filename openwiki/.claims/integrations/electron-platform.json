    {
      "id": "claim_facaf3b16043481289990e0f97f7e221",
      "statement": "Directory handles in the File System Access API are structured-cloneable and persisted in IndexedDB (key 'project-dirs'); because browsers never expose absolute paths, projects are identified by stable generated UUIDs instead of folderPath strings, allowing the same project to be reopened without re-picking and forking a duplicate.",
      "evidence": [
        {
          "resource": "repo://src/platform/fs.js#L26-L69",
