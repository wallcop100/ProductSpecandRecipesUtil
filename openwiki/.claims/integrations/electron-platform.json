    {
      "id": "claim_2187f3eef49b49a88a6549cdfca43e41",
      "statement": "In browser mode, the database is backed by sql.js (SQLite-WASM) running in memory, with persistence to IndexedDB on a debounced 300ms schedule; writes are debounced to batch rapid edits, and a flush() call immediately serializes the database on manual save or page unload.",
      "evidence": [
        {
          "resource": "repo://src/platform/db.js#L1-L50",
          "version": "repo-lines-v1:sha256:1cc8d8b123e754d5742193f042b467dfe2ddaf67588d6c21dddb3bd3e4fb72af:"
