        }
      ]
    },
    {
      "id": "claim_5f36afe9c67744e291ff7ff627613d0b",
      "statement": "Tokenization is mechanical and assumes no syntax: leading/trailing punctuation peels into single-character tokens, hyphens internal to words are kept whole, and no separator ('+', parentheses, etc.) has fixed meaning.",
      "evidence": [
        {
          "resource": "repo://src/utils/productCodes.js#L25-L69",
          "version": "repo-lines-v1:sha256:30ce0c3c2b006ffd9b6c9ab1ca6c70a18721ad97f0092f89f96ff5392a499a2c:"
