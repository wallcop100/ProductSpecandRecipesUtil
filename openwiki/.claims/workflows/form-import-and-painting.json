    },
    {
      "id": "claim_e4aa3e5b56874a7bb977e9645e3ed932",
      "statement": "Code runs are maximal sequences of adjacent tokens marked 'code', split on line breaks; adjacent code tokens form one code (e.g., 'V6815' + '000' = one code 'V6815 000'), while non-adjacent tokens form separate codes regardless of separators.",
      "evidence": [
        {
          "resource": "repo://src/utils/productCodes.js#L116-L130",
          "version": "repo-lines-v1:sha256:02cb32253fcfe27ac338c9c0962f8ebc67fc210c1a3228620577a45285d67035:"
