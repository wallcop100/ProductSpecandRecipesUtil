    {
      "id": "claim_efac7b630b2341d597657c27b4140c8d",
      "statement": "alignmentGaps() identifies three classes of gaps: (1) specRows.wrappers — wrapper ETs used in recipes with no spec row (safe to auto-fill with N/A), (2) specRows.products — non-wrapper ETs used in recipes lacking spec rows (need human review), (3) dbRows — ET refs named in spec or recipes but missing from DesignDB. This function is the canonical source for gap counts across the Product Spec screen, validation panel, and export summary.",
      "evidence": [
        {
          "resource": "repo://src/utils/specAlignment.js#L69-L142",
          "version": "repo-lines-v1:sha256:2542281681887d884ad6ccffe908173c85c98481f2cbaf75769ca122b54d3650:"
        }
      ]
    },
    {
      "id": "claim_c37f31318f7246b9933298b53f84eda6",
      "statement": "BulkCreateETModal proposes and edits multiple new ElementTypes at once from product codes. Proposals are grouped by family and sorted by confidence. Users can drag codes between families, create new families inline, or reassign via a menu. A 'Needs a family' group blocks Apply until all codes are assigned or unticked. Each proposal shows a verification icon (✓ for firm rules, ? for guesses); hover shows the reasoning (family rule, company line, shape match, etc.).",
      "evidence": [
        {
          "resource": "repo://src/components/BulkCreateETModal.jsx#L17-L85",
