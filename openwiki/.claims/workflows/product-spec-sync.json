    {
      "id": "claim_2663ba24cfa3456c90a8b9e3bc87e29c",
      "statement": "Product spec validation is founded on two invariants enforced by specAlignment.js: (1) every ElementType named in the Product Spec or Recipes must exist in the DesignDB, and (2) every ElementType used in a recipe must have a Product Spec row to record what to buy. A corollary reversed older behavior: DesignDB entries used in no recipe need nothing.",
      "evidence": [
        {
          "resource": "repo://src/utils/specAlignment.js#L1-L21",
          "version": "repo-lines-v1:sha256:337ff2fece28901dbeb0d3da5e5bdc6d4fcdfb62093991078975b7131e336439:"
        }
      ]
    },
    {
      "id": "claim_87bfd26f17d44cfbb5fe392f5fb4f72a",
      "statement": "ProductSpecTable.jsx presents a table of product spec rows with columns for ElementTypeRef, Manufacturer, ProductCode, ComponentDescription, TBC flag, and IsDeleted marker. Ghost rows (highlighted yellow) appear for ElementTypes in recipes with no spec entry; editing any cell in a ghost row creates the spec row with that value.",
      "evidence": [
        {
          "resource": "repo://src/components/ProductSpecTable.jsx#L1-L50",
