    {
      "id": "claim_4d21641b25b94422b9f4fad2d3cd3d68",
      "statement": "ProductSpecScreen organizes rows into status categories: Missing Spec (no row for recipe-used ETs), Partial/TBC (lacking manufacturer or code), Complete (filled, not TBC), Deleted (IsDeleted='Y'), Duplicate (same manufacturer+code pair), and Skipped (in user-configured families). Stats are computed by specAlignment.alignmentGaps() and skippedRefs(), ensuring consistency across the Product Spec, validation panel, and export summary.",
      "evidence": [
