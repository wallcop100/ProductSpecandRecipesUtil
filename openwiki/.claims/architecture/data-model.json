    {
      "id": "claim_71d0f44667c24c8f928183b6aeb70582",
      "statement": "SQLite (via dbSchema.js) stores derived metadata only: project configs, templates, slot mappings, ET collections, position UI (tags, notes, ignored flag), style exemplars, and recipe patterns. PS and RS rows are never persisted to SQLite; they live in Zustand state and are derived from Excel on every load.",
      "evidence": [
        {
          "resource": "repo://src/platform/dbSchema.js#L135-L261",
          "version": "repo-lines-v1:sha256:82b20f1a82ae25aca799a55f914f8e9b36d4ffdf5394dba6cb94a9bff8a3d560:"
        }
      ]
    },
    {
      "id": "claim_e47703c40ee745e4948a1d703af6a352",
      "statement": "The export pipeline enforces field-level patches (not whole-row rewrites) for PS and RS, preserving upstream edits on columns the app does not own. Before writing, the backend compares each change's `before` values against live disk cells; any mismatch blocks the entire file (conflict). On conflict, the app reloads the file from disk, keeps the dirty registry intact, and offers the user a per-cell conflict list to resolve.",
      "evidence": [
        {
          "resource": "repo://EXPORT_PLAN.md#L42-L125",
          "version": "repo-lines-v1:sha256:e1349b2fe644712146d66c53f7f387dff14ee8d5dd425eb0f54b23819256f7bb:"
        }
      ]
    }
