    {
      "id": "claim_a38ef605d9ed4c7badbf8f0ef1618bb6",
      "statement": "The Recipe Builder app's persistent truth consists of three Excel workbooks: DesignDB (read-only master catalogue of ElementTypes and PositionTypes), Product Spec (PS, app-writable product metadata per ElementType), and Recipes Spec (RS, app-writable position-by-position recipe assignments). All three are parsed in-browser via SheetJS into JavaScript objects, managed in Zustand state, and tracked as dirty registries for export back to Excel.",
      "evidence": [
        {
          "resource": "repo://EXPORT_PLAN.md#L1-L50",
          "version": "repo-lines-v1:sha256:d0d80d5c1e84905dfc08c4d71ec6ad8f30c841f769ed36e1427d38338fba084a:"
