    },
    {
      "id": "claim_f901bafcef1142db912f0edfc5dc276f",
      "statement": "When importing a new product code, styleFor() finds nearest exemplars (same maker, shared code stem ≥4 chars), extracts their ref shape, and carries the middle segment to the new code, mapping code-derived parts (e.g., '260' → '350'). Text-derived parts are dropped if the new product's name/description doesn't mention them.",
      "evidence": [
        {
          "resource": "repo://src/utils/styleLibrary.js#L117-L150",
