        }
      ]
    },
    {
      "id": "claim_32a315c8539b4a36a51d2d9ddabf5475",
      "statement": "learning.js watches store changes to elementTypes and psRows. After a 4-second settle period, it harvests exemplars, compares to the previous snapshot, and shares only changed exemplars and assignments with the companion server in merge mode. Unchanged data is not resent.",
      "evidence": [
        {
          "resource": "repo://src/platform/learning.js#L114-L122",
