  "claims": [
    {
      "id": "claim_3143ee962c16458fbd7cc83f6f91dcd2",
      "statement": "A recipe pattern's kind is determined by three independent dimensions: wrapper type (DL/LIN/PS/TRACK/TRACKPS), driver location (LOCAL/REMOTE/INTEGRAL/NONE), and environment (EXT/INT based on position family). These dimensions index all recipe patterns and precedent lookups.",
      "evidence": [
        {
          "resource": "repo://src/utils/recipePatterns.js#L110-L111",
          "version": "repo-lines-v1:sha256:407ba9590e79bfd5e4e1bfa6279a8b166a37e0411dd6d20101fd72e77402da40:"
        },
        {
          "resource": "repo://src/utils/recipePatterns.js#L16-L19",
          "version": "repo-lines-v1:sha256:6af734ee67c5723e05424d2b933f56069c470d91d43672f6e52495d75132c3b7:"
        }
      ]
    },
    {
      "id": "claim_a892834c132a4cc5b38858ed311ebdd8",
      "statement": "Patterns are harvested from recipes using harvestPatterns(), which groups recipes by kind, extracts design elements and ingredients, and tallies each role's frequency across positions of that kind. Patterns are read-only; the only way to change them is to build and save new recipes.",
      "evidence": [
        {
          "resource": "repo://src/utils/recipePatterns.js#L96-L142",
          "version": "repo-lines-v1:sha256:a1953c2cdfb29d9b3ffb3d06020974b2512bc03a1e18a7ddc61c07c960a6630b:"
        }
      ]
    },
    {
      "id": "claim_46149efc3d4849d687a18b5709cd0089",
      "statement": "Recipe proposal looks up patterns in fixed precedence order: this project first, then projects opened before (style library), then other projects via companion, then finished projects shipped with the app. The first source with patterns for a given kind wins.",
      "evidence": [
        {
          "resource": "repo://src/utils/recipePatterns.js#L7-L13",
          "version": "repo-lines-v1:sha256:724cc1e2bdc74637c20be05483238f8cba8b81c38a2cd19415743e71a4cfb6e6:"
        },
        {
          "resource": "repo://src/utils/recipeProposal.js#L42-L50",
          "version": "repo-lines-v1:sha256:fd8cef214f0e458a81b865a282dfef39dc85c89986a51717dd4d7b5e83f2e1e6:"
        }
      ]
    },
    {
      "id": "claim_021a489079d64f4fa00aca725acdcc20",
      "statement": "proposeRecipe() constructs a first-draft recipe by: (1) determining kind from driver location and position family, (2) inferring wrapper from precedent, (3) looking up pattern roles, (4) placing Form products in their standard slots, (5) suggesting missing parts from this project or precedent, and (6) marking suggested vs. certain parts.",
      "evidence": [
        {
          "resource": "repo://src/utils/recipeProposal.js#L135-L256",
          "version": "repo-lines-v1:sha256:1b5ae08d722dfdb1fd7bc8d5cf9d6acee8f1a7b327b170a148a32a68bb7f57f7:"
        }
      ]
    },
    {
      "id": "claim_62bc297e5eb64b68b5968e3af6455b86",
      "statement": "pickPart() searches for a role in this order: (1) same kind in this project, (2) any position in this project, (3) project ElementTypes, (4) style library exemplars, (5) empty/missing. Drivers are special: only proposed if another position uses the exact same fitting.",
      "evidence": [
        {
          "resource": "repo://src/utils/recipeProposal.js#L69-L107",
          "version": "repo-lines-v1:sha256:4520327237f66bf8b9a214db5b2edfe125f94a6d94712ca25913226e15f9b041:"
        }
      ]
    },
    {
      "id": "claim_2ca0730694454a818e7adc609d7b64ba",
      "statement": "Wrappers are shared among positions of the same kind when they contain exactly the same internal ElementType refs. A wrapper that would be unique to one position is marked as 'new wrapper' and is never reused. Shared wrappers come from resolveWrapper() and persist across the project.",
      "evidence": [
        {
          "resource": "repo://src/utils/recipeProposal.js#L253-L254",
          "version": "repo-lines-v1:sha256:25e9377b2f57147c08a851b5b05858b263624cbdd4ea9867cd8fdc1275b81461:"
