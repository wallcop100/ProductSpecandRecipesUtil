          "version": "repo-lines-v1:sha256:92efff88f8d0145a3cc8b87999218f76759264e53dba745149f115db302bc650:"
        }
      ]
    },
    {
      "id": "claim_04e75116e4b34b738a8ab52c452b482b",
      "statement": "Exemplars are harvested from ElementTypes that have both a family and a Product Spec assignment (maker + code). Each exemplar records maker, code, family, ref, name, and description. Exemplars are shared across projects via the style library and optional companion server.",
