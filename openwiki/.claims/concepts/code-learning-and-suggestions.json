    {
      "id": "claim_8dae13e75d254cf9a736b5ca2c8f4c36",
      "statement": "Tokenization is purely mechanical: it splits on whitespace, peels leading/trailing punctuation into single-char tokens, preserves internal punctuation, and marks line breaks; it ascribes no meaning to any separator.",
