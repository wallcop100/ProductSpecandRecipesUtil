    },
    {
      "id": "claim_fac2b5d622c04c2f9b4d11e51963a443",
      "statement": "Code runs are maximal adjacent sequences of 'code' tokens, bounded by line breaks and by absence of alphanumerics; captures emit (code, note, range) tuples where notes are attached via delimiter-segment membership or reading-order proximity.",
      "evidence": [
