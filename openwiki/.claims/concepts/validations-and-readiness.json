    {
      "id": "claim_4c8f75cb73464852996c72c06f089a9c",
      "statement": "BLOCKING_RULES in validationTasks.js identifies four rules that prevent correct export: BLANK_RECIPE_CONTAINER, MISSING_IS_DESIGN, DUPLICATE_IS_DESIGN, and ELEMENT_TYPE_NOT_IN_DB. All other issues are advisory and do not stop export.",
